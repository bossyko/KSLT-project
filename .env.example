# ============================================
# KSLT — Environment Variables
# ============================================
# Скопируй в .env и заполни реальными значениями.
# НЕ коммить .env в git!

# ---- Supabase (автоматически доступны в Edge Functions) ----
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxx          # Публичный ключ (безопасен для фронта, RLS защищает данные)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx        # Серверный ключ (ТОЛЬКО в Edge Functions, обходит RLS)

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxx              # Токен бота @KSLTennisBot (BotFather)
TELEGRAM_GROUP_CHAT_ID=-100xxxxx                  # Chat ID группы KSLT для рассылок

# ---- Cron ----
CRON_SECRET=xxxxx                                 # Секрет для pg_cron → Edge Functions (произвольная строка)

# ---- Frontend (js/supabase-config.js) ----
# SUPABASE_URL и SUPABASE_ANON_KEY захардкожены в supabase-config.js
# Это публичные ключи — безопасность через RLS, не через секретность ключа
