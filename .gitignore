# macOS
.DS_Store

# Node & tools
node_modules/
.env
.env.local
coverage/

# IDE
.idea/
.claude/

# Secrets (Firebase, API keys)
secrets/

# Backups
*.bak

# Playwright / Tests
# Базовый срез продукта для сверки: `git worktree add _bazovy <коммит>`.
# Нынешние пробы прогоняются по СТАРОМУ продукту — так видно, моя правка
# уронила пробу или она была красной до неё. Папка временная.
_bazovy/
test-results/
# Отчёты Playwright. ШАБЛОНОМ, А НЕ СПИСКОМ: 27.09 папка html-stend
# уехала в репозиторий — 143 файла — только потому, что её имени не
# было в перечне. Каждый новый конфиг заводит свою папку отчёта.
tests/reports/html/
tests/reports/html-*/
tests/reports/results.json
tests/reports/results-bazovy.json
tests/reports/results-nyneshniy.json
tests/reports/zamer-*.txt
.playwright/

# Картинки новостей с tennis.kg — временные, заливаются в Supabase Storage
import/news-images/

# Адрес и ключ тестовой базы — у каждого свои
.env.test

# Сессии для входа в проверках — создаются заново при каждом прогоне
tests/.auth/

# Служебные файлы привязки Supabase CLI
supabase/.temp/

# Ключи для выгрузки резервной копии (tools/backup.js)
.env.backup

# Сами выгрузки: там боевые данные игроков и все загруженные фотографии.
# В репозиторий им нельзя — он публичный
backups/

# Сборки приложения — большие двоичные файлы, в репозитории им не место
builds/

# Выгрузки из базы: там персональные данные игроков
exports/

# Снятый с работы код — лежит на моей машине как справка.
# В боевой сайт и в репозиторий ему незачем
archive/

# Файл блокировки Deno — появляется от локальных проверок функций
deno.lock
tools/_ntrp-plan.json

# Превью телефона: рабочий инструмент проверки, живёт только локально
pages/_preview-mobile.html

# локальные резервные копии Claude
.kslt-backup/

# Копилка для интервью — личный файл Кости, не для репозитория
ИНТЕРВЬЮ.md

# Правила работы Кости с Claude. Решение 21.09: файл живёт на машине,
# в репозиторий не идёт — как и ИНТЕРВЬЮ.md
CLAUDE.md

# Снимки прибора 20-header-offsets: сотни JSON, живут между прогонами и
# нужны только для сравнения «до/после» на своей машине. Метка прогона
# внутри них и так делает их одноразовыми.
tests/reports/header-snapshot/
tests/reports/header-taps/
tests/reports/header-dropdowns/
tests/reports/header-row-fit/
tests/reports/burger-inside/
tests/reports/header-snapshot-before/
tests/reports/.run-id
tests/reports/_zamer/
tests/reports/auth-forms/
tests/reports/vhod/

# Папка для передачи файлов в песочницу замеров — в репозитории не нужна
_sync/

# Слепки турниров — откаты состояния базы, снятые перед опасным шагом.
# В них ФИО всех заявленных. ПРИЧИНА ПОПРАВЛЕНА 07.11: репозиторий больше
# не публичный (закрыт) и сайт давно не на GitHub Pages, а на nginx. Но
# правило остаётся: личные данные не кладутся в гит вообще — приватность
# репозитория это настройка, которую меняют одним переключателем, а
# выгрузка с ФИО останется в истории навсегда.
slepki/
# Снимки прогона метки: живут столько же, сколько последний прогон, и на
# них могут стоять полные имена. Та же причина, что у слепков выше:
# в истории гита личным данным не место, независимо от приватности
tests/reports/metka-*.png
tests/reports/sloty-*.png
snimki/

# Временное для приборов: сюда кладётся вход в тестовую базу, он несёт живой токен
tmp/

# Временные архивы слепков (svezhee.tgz и подобные).
# 06.10 в корне лежал снимок трёх файлов, которые и так под гитом:
# css/players.css, css/podium.css, js/players.js.
*.tgz
*.tar.gz

# Рабочие файлы, которые не относятся к сайту: Word на вычитку
# и собранная обложка канала — исходник обложки лежит в maket/.
kslt-kyrgyzskie-teksty-na-vychitku.docx
kslt-youtube-oblozhka.png
