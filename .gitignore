.DS_Store

# Node & tools
node_modules/
.env
.env.local
coverage/

# IDE
.idea/
.claude/

# Secrets (Firebase, API keys)
secrets/

# Backups
*.bak

# Playwright / Tests
test-results/
tests/reports/html/
tests/reports/results.json
.playwright/

# Картинки новостей с tennis.kg — временные, заливаются в Supabase Storage
import/news-images/

# Адрес и ключ тестовой базы — у каждого свои
.env.test

# Сессии для входа в проверках — создаются заново при каждом прогоне
tests/.auth/

# Служебные файлы привязки Supabase CLI
supabase/.temp/

# Ключи для выгрузки резервной копии (tools/backup.js)
.env.backup

# Сами выгрузки: там боевые данные игроков и все загруженные фотографии.
# В репозиторий им нельзя — он публичный
backups/

# Сборки приложения — большие двоичные файлы, в репозитории им не место
builds/

# Выгрузки из базы: там персональные данные игроков
exports/
