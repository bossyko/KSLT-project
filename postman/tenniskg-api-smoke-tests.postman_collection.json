	"item": [
		{
			"name": "GET Home Page",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
							"pm.test(\"Response time < timeout\", () => pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get(\"timeoutMs\"))));",
							"pm.test(\"Content-Type is HTML\", () => {",
							"  pm.response.to.have.header(\"content-type\");",
							"  pm.expect(pm.response.headers.get(\"content-type\").toLowerCase()).to.include(\"text/html\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						""
					]
				}
			},
			"response": []
		},
