			"name": "GET News Page",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
							"pm.test(\"Contains 'Новости' or 'news'\", () => {",
							"  const t = pm.response.text().toLowerCase();",
							"  pm.expect(t).to.satisfy(s => s.includes(\"новост\") || s.includes(\"news\"));",
							"});"
