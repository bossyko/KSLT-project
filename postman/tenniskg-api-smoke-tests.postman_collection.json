				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Login page 200\", () => pm.response.to.have.status(200));",
							"pm.test(\"Has phone/password hints\", () => {",
							"  const h = pm.response.text().toLowerCase();",
							"  pm.expect(h).to.satisfy(s => s.includes(\"телефон\") || s.includes(\"phone\"));",
							"  pm.expect(h).to.satisfy(s => s.includes(\"парол\") || s.includes(\"password\"));",
